//@version=6
// Trader Mayne "Whiteboard Series" framework.
// Built from episodes 1-25: glossary, market structure, liquidity, dealing ranges, HTF bias,
// fair value gaps, order blocks / breakers, OB vs FVG, OTE, AMD / Judas swing, equal highs/lows,
// the four-step top-down process (direction -> context -> setup -> entry), and the five-minute
// entry model (zone tag -> structure break -> displacement -> FVG pullback -> stop / target),
// reversal vs continuation setups with H4/H1 confirmation, the 15-minute variant, the silver bullet window,
// the seven no-trade disqualifiers, and the risk framework (stop = invalidation, position sizing,
// 2R exits with partials at internal liquidity, break-even win-rate math), and scaling in
// (split the same risk across a zone, or add only on new confirmed models), news as a liquidity
// driver, nested dealing ranges (range stacking, displacement-only range resets), and time as a
// filter and grade (kill zones, silver bullet windows, crypto trading day), SMT divergence against a
// correlated symbol (optional grade upgrade / filter at key levels), and the daily-bias checklist with
// previous day / week / month liquidity, chart patterns read as liquidity plus structure (range AMD),
// and behavioural guard-rails (oversizing warning, daily signal cap, tilt guard, signal stats).
// Entry-model, killzone-timing, SMT, risk-management and scaling episodes are not implemented yet.
indicator("Trader Mayne Framework", shorttitle = "TM Frame", overlay = true,
     max_bars_back = 500, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500)

// ───────────────────────────── Inputs ─────────────────────────────
G_STR = "Market structure"
swingN     = input.int(1, "Swing candles each side (1 = three-candle swing)", minval = 1, maxval = 5, group = G_STR)
majorN     = input.int(8, "Major swing length (dealing range)", minval = 2, maxval = 50, group = G_STR)
atrLen     = input.int(14, "ATR length", minval = 1, group = G_STR)
dispMult   = input.float(1.2, "Displacement: candle body ≥ ATR ×", minval = 0.1, step = 0.1, group = G_STR)
showStruct = input.bool(true, "Show MSB / MSS", group = G_STR)

G_HTF = "Top-down process (episode 12)"
useHTF       = input.bool(true, "Use top-down bias", group = G_HTF)
dirTF        = input.timeframe("W", "Step 1a - direction timeframe (weekly)", group = G_HTF)
syncTF       = input.timeframe("D", "Step 1b - sync timeframe (daily)", group = G_HTF)
ctxTF        = input.timeframe("240", "Step 2 - context timeframe (H4): points of interest", group = G_HTF)
htfMajor     = input.int(5, "HTF major swing length", minval = 2, maxval = 30, group = G_HTF)
setupTF      = input.timeframe("60", "Step 3 - setup timeframe (H1): confirmation", group = G_HTF)
allowRev     = input.bool(true, "Allow reversal setups when the sync timeframe still disagrees (needs H4 / H1 confirmation)", group = G_HTF)
reqConfirm   = input.bool(true, "Require H4 / H1 confirmation unless the sync timeframe already agrees", group = G_HTF)
minStack     = input.int(0, "Require at least N of the 4 higher-timeframe ranges (W / D / H4 / H1) on the correct side of equilibrium", minval = 0, maxval = 4, tooltip = "Episode 19 stacking: longs want discount on every timeframe, shorts want premium. 0 = off (the stack is still graded and shown).", group = G_HTF)
reqPOI       = input.bool(true, "Require the entry zone to sit inside a context-timeframe POI", group = G_HTF)
pdSource     = input.string("Sync TF range", "Premium / discount source", options = ["Sync TF range", "Direction TF range", "Chart range"], group = G_HTF)
showHTFRange = input.bool(true, "Plot higher-timeframe ranges and context POIs", group = G_HTF)

G_RNG = "Dealing range / OTE"
showRange = input.bool(true, "Show chart dealing range (high, low, EQ)", group = G_RNG)
showPD    = input.bool(true, "Shade premium / discount", group = G_RNG)
showOTE   = input.bool(true, "Show OTE zone", group = G_RNG)
oteLo     = input.float(0.62, "OTE start (0.618 → 0.62)", minval = 0.5, maxval = 0.9, step = 0.005, group = G_RNG)
oteHi     = input.float(0.79, "OTE end (0.786 → 0.79)", minval = 0.5, maxval = 0.95, step = 0.005, group = G_RNG)
showOldRange = input.bool(true, "Mark the old range high / low after a displacement reset", group = G_RNG)
sweetSpot = input.float(0.705, "Sweet spot", minval = 0.5, maxval = 0.95, step = 0.005, group = G_RNG)

G_POI = "Points of interest (OB / breaker / FVG)"
OBM_LAST   = "Last opposite candle before impulse"
OBM_EXTREME = "Candle at leg extreme"
showOB   = input.bool(true, "Order blocks", group = G_POI)
showBrk  = input.bool(true, "Breaker blocks (failed OBs)", group = G_POI)
showFVG  = input.bool(true, "Fair value gaps", group = G_POI)
obMode   = input.string(OBM_LAST, "Order block candle", options = [OBM_LAST, OBM_EXTREME], group = G_POI)
minShow  = input.int(2, "Minimum quality score to draw (0-7)", minval = 0, maxval = 7, group = G_POI)
fvgMin   = input.float(0.3, "Minimum FVG size (ATR ×)", minval = 0.0, step = 0.1, group = G_POI)
maxZones = input.int(14, "Max zones on chart", minval = 2, maxval = 60, group = G_POI)
lifeBars = input.int(600, "Zone lifespan (bars)", minval = 50, maxval = 5000, group = G_POI)

G_LIQ = "Liquidity"
showLiq    = input.bool(true, "Draw resting liquidity (swing highs / lows)", group = G_LIQ)
showSweeps = input.bool(true, "Mark sweeps (SFP / break-and-close)", group = G_LIQ)
eqTol      = input.float(0.1, "Equal highs/lows tolerance (ATR ×)", minval = 0.0, step = 0.05, group = G_LIQ)
maxLiq     = input.int(16, "Max unswept levels tracked", minval = 4, maxval = 60, group = G_LIQ)
sweepLook  = input.int(30, "A sweep counts as 'recent' for (bars)", minval = 3, maxval = 300, group = G_LIQ)

G_SES = "Sessions (intraday charts)"
showKZ     = input.bool(true, "Shade sessions", group = G_SES)
tz         = input.string("America/New_York", "Session timezone", group = G_SES)
sbA        = input.session("0300-0400", "Silver bullet window 1", group = G_SES)
sbB        = input.session("1000-1100", "Silver bullet window 2", group = G_SES)
sbC        = input.session("1400-1500", "Silver bullet window 3", group = G_SES)
asiaS      = input.session("2000-0000", "Asia (accumulation)", group = G_SES)
lonS       = input.session("0200-0500", "London kill zone", group = G_SES)
nyS        = input.session("0700-1000", "New York kill zone", group = G_SES)
pmS        = input.session("1330-1630", "New York afternoon window (weaker: continuation / retrace)", group = G_SES)
allowPM    = input.bool(false, "Count the afternoon window as a kill zone", group = G_SES)
cryptoS    = input.session("0800-2100", "Crypto trading day (UTC)", group = G_SES)
timeGrade  = input.bool(true, "Downgrade a setup one grade when it is outside the kill zones", group = G_SES)
showAsia   = input.bool(true, "Show Asian range", group = G_SES)
showJudas  = input.bool(true, "Mark Judas swings (Asian range sweep + reclaim)", group = G_SES)
showOpens  = input.bool(true, "Plot daily / weekly open", group = G_SES)
showMonday = input.bool(true, "Plot Monday high / low", group = G_SES)

G_ENT = "Entry model"
enableSig   = input.bool(true, "Enable setup signals", group = G_ENT)
entryModel  = input.string("5-minute model (FVG)", "Entry model", options = ["5-minute model (FVG)", "OB / breaker / FVG (general)"], tooltip = "5-minute model (episode 13): higher-timeframe zone tagged -> structure break with displacement -> enter on the pullback into the FVG it left. General: score-filtered order blocks, breakers and FVGs.", group = G_ENT)
tagLook     = input.int(80, "5m model: zone tag must be within (bars) of the break", minval = 5, maxval = 1000, group = G_ENT)
reqDisp     = input.bool(true, "5m model: require a displacement candle with the break", group = G_ENT)
minScoreEnt = input.int(3, "General model: minimum zone score to trade", minval = 0, maxval = 7, group = G_ENT)
entryMode   = input.string("Zone edge", "Entry at", options = ["Zone edge", "50% mean", "Bar close"], group = G_ENT)
stopMode    = input.string("Auto", "Stop beyond", options = ["Auto", "Zone edge", "Zone extreme", "Context POI"], tooltip = "Auto = his rule: continuation setups (sync timeframe already agrees) use the chart swing before the break; reversal setups use the context-timeframe POI. Zone extreme = chart swing / leg extreme. Context POI = beyond the higher-timeframe POI (wider stop, smaller size). Zone edge = tightest stop.", group = G_ENT)
reqSB       = input.bool(false, "Only trade inside a silver bullet window", group = G_ENT)
reqCrypto   = input.bool(false, "Only trade inside the crypto trading day (08:00-21:00 UTC)", group = G_ENT)
slBuf       = input.float(0.1, "Stop buffer (ATR ×)", minval = 0.0, step = 0.05, group = G_ENT)
minRR       = input.float(2.0, "Minimum reward : risk", minval = 0.5, step = 0.25, group = G_ENT)
allowCtr    = input.bool(false, "Allow trades against HTF bias", group = G_ENT)
reqSync     = input.bool(true, "Require chart structure to be synced with bias", group = G_ENT)
reqPD       = input.bool(true, "Require zone in discount (longs) / premium (shorts)", group = G_ENT)
reqKZ       = input.bool(false, "Require kill zone", group = G_ENT)
reqSweep    = input.bool(false, "Require a recent liquidity sweep", group = G_ENT)
fvgEntries  = input.bool(false, "Allow FVG-only entries (system prefers OB / breaker)", group = G_ENT)

G_RSK = "Risk and exits (episode 16)"
acct     = input.float(100000, "Account size", minval = 1, group = G_RSK)
riskPct  = input.float(1.0, "Risk per trade (%)  (his range: 0.5 - 2)", minval = 0.05, maxval = 10, step = 0.05, group = G_RSK)
winAt    = input.string("2R", "Count a signal as a win at", options = ["2R", "Full target"], tooltip = "His journal closes the trade at 2R. Full target = the external liquidity target.", group = G_RSK)
useGrades  = input.bool(false, "Grade setups by range stack and risk more on A+ (episode 19)", group = G_RSK)
riskAPlus  = input.float(2.0, "Risk % for an A+ (fully stacked) setup", minval = 0.05, maxval = 10, step = 0.05, group = G_RSK)
showPart = input.bool(true, "Show a partial-profit level at internal liquidity", group = G_RSK)
partPct  = input.float(25, "Partial size (%) - he uses 25%, 33% or up to two-thirds at the first target", minval = 5, maxval = 80, group = G_RSK)
scaleMode  = input.string("Single entry", "Entry scaling (episode 17)", options = ["Single entry", "Scale in zone", "Add on confirmation"], tooltip = "Scaling splits the SAME risk into pieces, it never adds risk. Single entry = one order (his advice until you are comfortable). Scale in zone = top / middle / bottom of the zone. Add on confirmation = smaller first entry, then adds only when a new, separate model forms.", group = G_RSK)
wTop       = input.float(30, "Scale in zone: top weight %", minval = 1, group = G_RSK)
wMid       = input.float(30, "Scale in zone: middle weight %", minval = 1, group = G_RSK)
wBot       = input.float(40, "Scale in zone: bottom weight %", minval = 1, group = G_RSK)
firstPct   = input.float(50, "Add on confirmation: first entry as % of full size", minval = 10, maxval = 100, group = G_RSK)
maxAdds    = input.int(2, "Add on confirmation: number of adds", minval = 1, maxval = 4, group = G_RSK)
trailStops = input.bool(true, "Add on confirmation: move the stop up to each new model's swing low", group = G_RSK)

G_AMD = "Range AMD / Wyckoff (episode 23)"
showAMD   = input.bool(true, "Mark a range sweep + reclaim followed by a structure break (spring / UTAD)", group = G_AMD)
amdN      = input.int(40, "Range length (bars)", minval = 10, maxval = 300, group = G_AMD)
amdMult   = input.float(6.0, "Range counts as compressed if its height is at most this many ATR", minval = 1.0, step = 0.5, group = G_AMD)
amdWindow = input.int(10, "Structure break must follow the sweep within (bars)", minval = 2, maxval = 100, group = G_AMD)

G_SMT = "SMT divergence (episode 21)"
useSMT   = input.bool(false, "Check SMT divergence against a correlated symbol", group = G_SMT)
smtSym   = input.symbol("BINANCE:ETHUSDT", "Comparison symbol (BTC vs ETH, NQ vs ES, EURUSD vs GBPUSD...)", group = G_SMT)
smtLen   = input.int(20, "Swing window (bars) on the chart timeframe", minval = 5, maxval = 200, group = G_SMT)
smtGap   = input.float(0.1, "Non-confirming asset must hold at least this % beyond its prior extreme (clear and obvious)", minval = 0.0, step = 0.05, group = G_SMT)
smtLook  = input.int(20, "An SMT counts for this many bars", minval = 3, maxval = 200, group = G_SMT)
reqSMT   = input.bool(false, "Require a recent SMT divergence to signal", tooltip = "Off by default: he treats SMT as a nice-to-have that upgrades conviction, not a requirement.", group = G_SMT)

G_BIAS = "Daily bias and liquidity map (episode 22)"
showMap    = input.bool(true, "Plot previous day / week / month highs and lows (dimmed once swept)", group = G_BIAS)
closeEdge  = input.float(0.10, "Yesterday's close counts as 'at the extreme' inside this fraction of its range", minval = 0.02, maxval = 0.4, step = 0.01, group = G_BIAS)
earlyHours = input.float(8, "A sweep is 'early' in the day if it happens within this many hours of the daily open", minval = 1, maxval = 23, group = G_BIAS)
reqBias    = input.bool(false, "Require the full daily bias to agree with the trade", tooltip = "Very selective. Off by default; the bias is still shown on the dashboard.", group = G_BIAS)
skipNoBias = input.bool(false, "Skip no-bias days (yesterday closed mid-range)", group = G_BIAS)

G_DQ = "No-trade filters (episode 15)"
minER     = input.float(0.10, "1. Bias clarity: minimum efficiency ratio on the direction timeframe (below = ranging, no trade)", minval = 0.0, maxval = 1.0, step = 0.01, tooltip = "Net move over 20 bars divided by total distance travelled. Near 0 = choppy / ranging. Set to 0 to disable.", group = G_DQ)
missRun   = input.float(5.0, "5. No chasing: cancel a 5m-model FVG if price runs this many ATR away without a retest", minval = 1.0, step = 0.5, group = G_DQ)
newsT1    = input.time(0, "6. News event 1 (0 = off)", group = G_DQ)
newsT2    = input.time(0, "6. News event 2 (0 = off)", group = G_DQ)
newsT3    = input.time(0, "6. News event 3 (0 = off)", group = G_DQ)
newsPre   = input.int(60, "6. Stay out this many minutes before news", minval = 0, group = G_DQ)
newsPost  = input.int(120, "6. Stay out this many minutes after news", minval = 0, group = G_DQ)
tiltN     = input.int(0, "7. Tilt guard: pause after this many consecutive stopped-out signals (0 = off)", minval = 0, group = G_DQ)
tiltCool  = input.int(50, "7. Tilt guard: pause length (bars)", minval = 1, group = G_DQ)
maxDaily  = input.int(0, "Overtrading guard: maximum signals per day (0 = off)", minval = 0, maxval = 20, group = G_DQ)

G_DSH = "Dashboard"
showDash = input.bool(true, "Show checklist dashboard", group = G_DSH)
dashPos  = input.string(position.top_right, "Position", options = [position.top_right, position.middle_right, position.bottom_right, position.top_left, position.middle_left, position.bottom_left], group = G_DSH)

G_COL = "Colors"
colBull = input.color(#26a69a, "Bullish", group = G_COL)
colBear = input.color(#ef5350, "Bearish", group = G_COL)
colMSS  = input.color(#ff9800, "MSS", group = G_COL)
colBrkL = input.color(#00bcd4, "Bullish breaker", group = G_COL)
colBrkS = input.color(#ab47bc, "Bearish breaker", group = G_COL)
colLiq  = input.color(#b2b5be, "Liquidity", group = G_COL)
colAsia = input.color(#9c27b0, "Asia", group = G_COL)
colLon  = input.color(#2196f3, "London", group = G_COL)
colNY   = input.color(#ffb300, "New York", group = G_COL)

bool modelOn = entryModel == "5-minute model (FVG)"

// ───────────────────── Higher-timeframe structure ─────────────────────
// Runs inside request.security on series shifted by one bar, so the HTF values never use the
// still-forming HTF candle and do not repaint.
f_htf(float h, float l, float c, int majLen) =>
    float sph = (h[1] > h[2] and h[1] > h[0]) ? h[1] : na
    float spl = (l[1] < l[2] and l[1] < l[0]) ? l[1] : na
    var float sh = na
    var float sl = na
    var bool shDone = true
    var bool slDone = true
    var int tr = 0
    if not na(sph)
        sh := sph
        shDone := false
    if not na(spl)
        sl := spl
        slDone := false
    if not shDone and c > sh
        shDone := true
        tr := 1
    if not slDone and c < sl
        slDone := true
        tr := -1
    float mph = ta.pivothigh(h, majLen, majLen)
    float mpl = ta.pivotlow(l, majLen, majLen)
    var float mHi = na
    var float mLo = na
    if not na(mph)
        mHi := mph
    if not na(mpl)
        mLo := mpl
    float path = math.sum(math.abs(ta.change(c)), 20)
    float eff = path > 0 ? math.abs(c - c[20]) / path : 0.0
    [tr, mHi, mLo, eff]

// Latest live points of interest on the context timeframe: order block (last opposite candle
// before a structure break) or fair value gap, until price closes through it.
f_ctx(float o, float h, float l, float c) =>
    float sph = (h[1] > h[2] and h[1] > h[0]) ? h[1] : na
    float spl = (l[1] < l[2] and l[1] < l[0]) ? l[1] : na
    var float sh = na
    var float sl = na
    var bool shDone = true
    var bool slDone = true
    var float bT = na
    var float bB = na
    var float sT = na
    var float sB = na
    var int tr = 0
    if not na(sph)
        sh := sph
        shDone := false
    if not na(spl)
        sl := spl
        slDone := false
    if not shDone and c > sh
        shDone := true
        tr := 1
        for i = 1 to 10
            if c[i] < o[i]
                bT := h[i]
                bB := l[i]
                break
    if not slDone and c < sl
        slDone := true
        tr := -1
        for i = 1 to 10
            if c[i] > o[i]
                sT := h[i]
                sB := l[i]
                break
    if l > h[2] and c[1] > o[1]
        bT := l
        bB := h[2]
    if h < l[2] and c[1] < o[1]
        sT := l[2]
        sB := h
    if not na(bB) and c < bB
        bT := na
        bB := na
    if not na(sT) and c > sT
        sT := na
        sB := na
    [bT, bB, sT, sB, tr]

[dirTrend, dirHi, dirLo, dirER]     = request.security(syminfo.tickerid, dirTF, f_htf(high[1], low[1], close[1], htfMajor), lookahead = barmerge.lookahead_off)
[syncTrend, syncHi, syncLo, syncER]  = request.security(syminfo.tickerid, syncTF, f_htf(high[1], low[1], close[1], htfMajor), lookahead = barmerge.lookahead_off)
[ctxBullTop, ctxBullBot, ctxBearTop, ctxBearBot, ctxTrend] = request.security(syminfo.tickerid, ctxTF, f_ctx(open[1], high[1], low[1], close[1]), lookahead = barmerge.lookahead_off)
[ctxTrend2, ctxHi, ctxLo, ctxER] = request.security(syminfo.tickerid, ctxTF, f_htf(high[1], low[1], close[1], htfMajor), lookahead = barmerge.lookahead_off)
[setupTrend, setupHi, setupLo, setupER] = request.security(syminfo.tickerid, setupTF, f_htf(high[1], low[1], close[1], htfMajor), lookahead = barmerge.lookahead_off)

// ───────────────────────────── Core series ─────────────────────────────
atr = ta.atr(atrLen)
bool bodyBig = math.abs(close - open) >= dispMult * atr

// ───────────────────── Chart market structure (3-candle swings) ─────────────────────
float ph  = ta.pivothigh(high, swingN, swingN)
float pl  = ta.pivotlow(low, swingN, swingN)
float mph = ta.pivothigh(high, majorN, majorN)
float mpl = ta.pivotlow(low, majorN, majorN)

var float shLvl = na
var int   shBar = na
var bool  shDone = true
var float slLvl = na
var int   slBar = na
var bool  slDone = true
var int   trend = 0

bool bullBrk = false
bool bearBrk = false
bool bullMSS = false
bool bearMSS = false
int  bullAnchor = na
int  bearAnchor = na

if not na(ph)
    shLvl := ph
    shBar := bar_index - swingN
    shDone := false
if not na(pl)
    slLvl := pl
    slBar := bar_index - swingN
    slDone := false

if not shDone and close > shLvl
    bullBrk := true
    bullMSS := trend == -1
    bullAnchor := shBar
    shDone := true
    if showStruct
        color mc = bullMSS ? colMSS : colBull
        line.new(shBar, shLvl, bar_index, shLvl, color = mc, style = line.style_dashed)
        label.new(math.round(math.avg(shBar, bar_index)), shLvl, (bullMSS ? "MSS" : "MSB") + (bodyBig ? " +D" : ""),
             style = label.style_label_down, color = color.new(mc, 85), textcolor = mc, size = size.tiny)
    trend := 1

if not slDone and close < slLvl
    bearBrk := true
    bearMSS := trend == 1
    bearAnchor := slBar
    slDone := true
    if showStruct
        color mc = bearMSS ? colMSS : colBear
        line.new(slBar, slLvl, bar_index, slLvl, color = mc, style = line.style_dashed)
        label.new(math.round(math.avg(slBar, bar_index)), slLvl, (bearMSS ? "MSS" : "MSB") + (bodyBig ? " +D" : ""),
             style = label.style_label_up, color = color.new(mc, 85), textcolor = mc, size = size.tiny)
    trend := -1

// ───────────────────────────── Dealing range ─────────────────────────────
var float rHi = na
var float rLo = na
var int   rHiBar = na
var int   rLoBar = na
bool rangeChanged = false
// Episode 19: a range only resets on expansion WITH displacement. A sweep / SFP / deviation leaves it in place.
var bool expUp = false
var bool expDn = false
if not na(rHi) and close > rHi and close > open and bodyBig
    expUp := true
if not na(rLo) and close < rLo and close < open and bodyBig
    expDn := true
if not na(mph)
    float oldHi = rHi
    if na(oldHi) or mph <= oldHi or expUp
        if not na(oldHi) and mph > oldHi
            expUp := false
            if showOldRange
                line.new(rHiBar, oldHi, bar_index, oldHi, extend = extend.right, color = color.new(colLiq, 40), style = line.style_dotted)
                label.new(bar_index, oldHi, "old range high", style = label.style_label_down, color = color.new(colLiq, 85), textcolor = colLiq, size = size.tiny)
        rHi := mph
        rHiBar := bar_index - majorN
        rangeChanged := true
if not na(mpl)
    float oldLo = rLo
    if na(oldLo) or mpl >= oldLo or expDn
        if not na(oldLo) and mpl < oldLo
            expDn := false
            if showOldRange
                line.new(rLoBar, oldLo, bar_index, oldLo, extend = extend.right, color = color.new(colLiq, 40), style = line.style_dotted)
                label.new(bar_index, oldLo, "old range low", style = label.style_label_up, color = color.new(colLiq, 85), textcolor = colLiq, size = size.tiny)
        rLo := mpl
        rLoBar := bar_index - majorN
        rangeChanged := true

bool chartRangeOK = not na(rHi) and not na(rLo) and rHi > rLo
bool dirRangeOK  = useHTF and not na(dirHi) and not na(dirLo) and dirHi > dirLo
bool syncRangeOK = useHTF and not na(syncHi) and not na(syncLo) and syncHi > syncLo
float pdHi  = pdSource == "Sync TF range" and syncRangeOK ? syncHi : pdSource == "Direction TF range" and dirRangeOK ? dirHi : (chartRangeOK ? rHi : na)
float pdLo  = pdSource == "Sync TF range" and syncRangeOK ? syncLo : pdSource == "Direction TF range" and dirRangeOK ? dirLo : (chartRangeOK ? rLo : na)
float pdMid = (pdHi + pdLo) / 2

// Step 1: weekly gives direction. Daily in line = continuation; daily still against = reversal setup (needs H4 / H1 confirmation).
bool dirClear = not useHTF or dirER >= minER
int biasDir = useHTF ? ((dirClear and (dirTrend == syncTrend or allowRev)) ? dirTrend : 0) : trend
float lo20 = ta.lowest(low, 20)
float hi20 = ta.highest(high, 20)

var line rngHi = na
var line rngLo = na
var line rngEq = na
var line rngSweet = na
var box  bxPrem = na
var box  bxDisc = na
var box  bxOte = na
if showRange and rangeChanged and chartRangeOK
    line.delete(rngHi)
    line.delete(rngLo)
    line.delete(rngEq)
    line.delete(rngSweet)
    box.delete(bxPrem)
    box.delete(bxDisc)
    box.delete(bxOte)
    int x0 = math.min(rHiBar, rLoBar)
    float eq = (rHi + rLo) / 2
    float rg = rHi - rLo
    bool bullLeg = rLoBar < rHiBar
    rngHi := line.new(x0, rHi, bar_index, rHi, extend = extend.right, color = color.new(colBear, 30), width = 1)
    rngLo := line.new(x0, rLo, bar_index, rLo, extend = extend.right, color = color.new(colBull, 30), width = 1)
    rngEq := line.new(x0, eq, bar_index, eq, extend = extend.right, color = color.new(colLiq, 20), style = line.style_dashed)
    if showPD
        bxPrem := box.new(x0, rHi, bar_index, eq, border_color = na, bgcolor = color.new(colBear, 93), extend = extend.right)
        bxDisc := box.new(x0, eq, bar_index, rLo, border_color = na, bgcolor = color.new(colBull, 93), extend = extend.right)
    if showOTE
        float o1 = bullLeg ? rHi - rg * oteLo : rLo + rg * oteLo
        float o2 = bullLeg ? rHi - rg * oteHi : rLo + rg * oteHi
        float sp = bullLeg ? rHi - rg * sweetSpot : rLo + rg * sweetSpot
        bxOte := box.new(x0, math.max(o1, o2), bar_index, math.min(o1, o2), border_color = color.new(colMSS, 50), bgcolor = color.new(colMSS, 88), extend = extend.right, text = "OTE", text_size = size.tiny, text_color = color.new(colMSS, 20), text_halign = text.align_right)
        rngSweet := line.new(x0, sp, bar_index, sp, extend = extend.right, color = color.new(colMSS, 40), style = line.style_dotted)

plot(showHTFRange and syncRangeOK ? syncHi : na, "Sync TF range high", color = color.new(colBear, 50), style = plot.style_linebr)
plot(showHTFRange and syncRangeOK ? syncLo : na, "Sync TF range low", color = color.new(colBull, 50), style = plot.style_linebr)
plot(showHTFRange and syncRangeOK ? (syncHi + syncLo) / 2 : na, "Sync TF equilibrium", color = color.new(colLiq, 50), style = plot.style_linebr)
plot(showHTFRange and dirRangeOK ? dirHi : na, "Direction TF range high", color = color.new(colBear, 75), style = plot.style_linebr)
plot(showHTFRange and dirRangeOK ? dirLo : na, "Direction TF range low", color = color.new(colBull, 75), style = plot.style_linebr)
pBullTop = plot(showHTFRange ? ctxBullTop : na, "Context bullish POI top", color = color.new(colBull, 70), style = plot.style_linebr)
pBullBot = plot(showHTFRange ? ctxBullBot : na, "Context bullish POI bottom", color = color.new(colBull, 70), style = plot.style_linebr)
fill(pBullTop, pBullBot, color = color.new(colBull, 88), title = "Context bullish POI")
pBearTop = plot(showHTFRange ? ctxBearTop : na, "Context bearish POI top", color = color.new(colBear, 70), style = plot.style_linebr)
pBearBot = plot(showHTFRange ? ctxBearBot : na, "Context bearish POI bottom", color = color.new(colBear, 70), style = plot.style_linebr)
fill(pBearTop, pBearBot, color = color.new(colBear, 88), title = "Context bearish POI")

// ───────────────────────────── Sessions ─────────────────────────────
bool isIntra = timeframe.isintraday
bool inAsia  = isIntra and not na(time(timeframe.period, asiaS, tz))
bool inLon   = isIntra and not na(time(timeframe.period, lonS, tz))
bool inNY    = isIntra and not na(time(timeframe.period, nyS, tz))
bool inPM    = isIntra and not na(time(timeframe.period, pmS, tz))
bool inKZ    = inLon or inNY or (allowPM and inPM)
bool inCrypto = isIntra and not na(time(timeframe.period, cryptoS, "UTC"))
f_news(int t) => t > 0 and time >= t - newsPre * 60000 and time <= t + newsPost * 60000
bool inNews  = f_news(newsT1) or f_news(newsT2) or f_news(newsT3)
bgcolor(inNews ? color.new(color.red, 88) : na, title = "News no-trade window")
bool inSB    = isIntra and (not na(time(timeframe.period, sbA, tz)) or not na(time(timeframe.period, sbB, tz)) or not na(time(timeframe.period, sbC, tz)))

bgcolor(showKZ and inSB ? color.new(color.white, 88) : na, title = "Silver bullet window")
bgcolor(showKZ and inLon ? color.new(colLon, 93) : showKZ and inNY ? color.new(colNY, 93) : showKZ and inPM ? color.new(colLiq, 94) : showKZ and inAsia ? color.new(colAsia, 95) : na)

var float asiaHi = na
var float asiaLo = na
var box   asiaBx = na
bool newAsia = inAsia and not inAsia[1]
if newAsia
    asiaHi := high
    asiaLo := low
    if showAsia
        asiaBx := box.new(bar_index, high, bar_index, low, border_color = color.new(colAsia, 40), bgcolor = color.new(colAsia, 90), text = "Asia", text_size = size.tiny, text_color = color.new(colAsia, 20), text_halign = text.align_left)
else if inAsia
    asiaHi := math.max(asiaHi, high)
    asiaLo := math.min(asiaLo, low)
if showAsia and not na(asiaBx) and (inAsia or inKZ)
    box.set_top(asiaBx, asiaHi)
    box.set_bottom(asiaBx, asiaLo)
    box.set_right(asiaBx, bar_index)

var bool judasBullDone = false
var bool judasBearDone = false
if newAsia
    judasBullDone := false
    judasBearDone := false
bool judasBull = false
bool judasBear = false
if showJudas and isIntra and not inAsia and inKZ and not na(asiaLo)
    if not judasBullDone and low < asiaLo and close > asiaLo
        judasBull := true
        judasBullDone := true
        label.new(bar_index, low, "Judas ↓ " + (inLon ? "(London)" : "(NY)"), style = label.style_label_up, color = color.new(colBull, 80), textcolor = colBull, size = size.tiny)
    if not judasBearDone and high > asiaHi and close < asiaHi
        judasBear := true
        judasBearDone := true
        label.new(bar_index, high, "Judas ↑ " + (inLon ? "(London)" : "(NY)"), style = label.style_label_down, color = color.new(colBear, 80), textcolor = colBear, size = size.tiny)

float dOpen = request.security(syminfo.tickerid, "D", open, lookahead = barmerge.lookahead_on)
float wOpen = request.security(syminfo.tickerid, "W", open, lookahead = barmerge.lookahead_on)
plot(showOpens ? dOpen : na, "Daily open", color = color.new(colNY, 20), style = plot.style_linebr)
plot(showOpens ? wOpen : na, "Weekly open", color = color.new(colLon, 20), style = plot.style_linebr)

int  dow   = dayofweek(time, tz)
bool isMon = dow == dayofweek.monday
var float monHi = na
var float monLo = na
if isMon
    if not isMon[1]
        monHi := high
        monLo := low
    else
        monHi := math.max(monHi, high)
        monLo := math.min(monLo, low)
plot(showMonday and not isMon ? monHi : na, "Monday high", color = color.new(colLiq, 30), style = plot.style_linebr)
plot(showMonday and not isMon ? monLo : na, "Monday low", color = color.new(colLiq, 30), style = plot.style_linebr)

// ───────────────────────── Zones: types and helpers ─────────────────────────
type Zone
    float top
    float bot
    int   dir      // 1 = supports longs, -1 = supports shorts
    int   kind     // 0 order block, 1 breaker, 2 fair value gap
    int   score
    int   t0       // left-most bar of the zone
    int   cb       // bar the zone was created on
    float ext      // sweep / leg extreme behind the zone (stop reference)
    bool  fromModel      // FVG left by a qualified 5-minute-model structure break
    bool  used
    box   bx
    line  mid

type Liq
    float px
    int   side     // 1 = buy-side (above highs), -1 = sell-side (below lows)
    int   bar
    line  ln
    bool  eq
    int   brk

var array<Liq> liqs = array.new<Liq>()
var int lastSmtBull = na
var int lastSmtBear = na
var array<Zone> zones = array.new<Zone>()
var array<Zone> pend  = array.new<Zone>()
var array<box>   tBoxes  = array.new<box>()
var array<label> tLabels = array.new<label>()
var array<line>  tLines  = array.new<line>()

f_isOpp(int dir, int i) =>
    dir == 1 ? close[i] < open[i] : close[i] > open[i]

// 0-2 points: zone on the correct side of equilibrium, plus zone inside the OTE band.
f_loc(int dir, float mid) =>
    int s = 0
    if not na(pdHi) and not na(pdLo) and pdHi > pdLo
        float rng = pdHi - pdLo
        if (dir == 1 and mid < pdMid) or (dir == -1 and mid > pdMid)
            s += 1
        float ret = dir == 1 ? (pdHi - mid) / rng : (mid - pdLo) / rng
        if ret >= oteLo and ret <= oteHi
            s += 1
    s

// Range stacking (episode 19): how many of the weekly / daily / H4 / H1 ranges have price on the
// side of equilibrium that favours the trade (discount for longs, premium for shorts).
f_inZone(float hi, float lo, int dir) =>
    float z = na
    if not na(hi) and not na(lo) and hi > lo
        float m = (hi + lo) / 2
        z := ((dir == 1 and close < m) or (dir == -1 and close > m)) ? 1.0 : 0.0
    z

f_stack(int dir) =>
    int st = 0
    int tot = 0
    float a = f_inZone(dirHi, dirLo, dir)
    float b = f_inZone(syncHi, syncLo, dir)
    float c = f_inZone(ctxHi, ctxLo, dir)
    float d = f_inZone(setupHi, setupLo, dir)
    if not na(a)
        tot += 1
        st += int(a)
    if not na(b)
        tot += 1
        st += int(b)
    if not na(c)
        tot += 1
        st += int(c)
    if not na(d)
        tot += 1
        st += int(d)
    [st, tot]

f_grade(int dir) =>
    [st, tot] = f_stack(dir)
    string g = tot < 3 ? "B" : st == tot ? "A+" : st == tot - 1 ? "A" : "B"
    if timeGrade and isIntra and not (inKZ or inSB or inPM)
        g := g == "A+" ? "A" : "B"
    bool smtNow = dir == 1 ? (not na(lastSmtBull) and bar_index - lastSmtBull <= smtLook) : (not na(lastSmtBear) and bar_index - lastSmtBear <= smtLook)
    if useSMT and smtNow
        g := g == "B" ? "A" : "A+"
    g

f_riskPct(int dir) =>
    (useGrades and f_grade(dir) == "A+") ? riskAPlus : riskPct

f_letter(float hi, float lo) =>
    (na(hi) or na(lo) or hi <= lo) ? "-" : close < (hi + lo) / 2 ? "D" : "P"

f_disp(int dir) =>
    float need = dispMult * atr
    bool ok = false
    for i = 0 to 2
        if (dir == 1 and close[i] - open[i] >= need) or (dir == -1 and open[i] - close[i] >= need)
            ok := true
    ok

f_removeZone(Zone z) =>
    box.delete(z.bx)
    line.delete(z.mid)
    true

f_addZone(float top, float bot, int dir, int kind, int score, int t0, float ext, bool star) =>
    color base = kind == 0 ? (dir == 1 ? colBull : colBear) : kind == 1 ? (dir == 1 ? colBrkL : colBrkS) : (dir == 1 ? colBull : colBear)
    string nm = (dir == 1 ? "Bull " : "Bear ") + (kind == 0 ? "OB" : kind == 1 ? "BRK" : "FVG") + " " + str.tostring(score) + (star ? "★" : "")
    float mid = (top + bot) / 2
    box bx = box.new(t0, top, bar_index + 1, bot, border_color = color.new(base, 30), border_style = kind == 2 ? line.style_dotted : line.style_solid,
         bgcolor = color.new(base, kind == 2 ? 92 : 84), extend = extend.right, text = nm, text_size = size.tiny, text_color = color.new(base, 10), text_halign = text.align_right)
    line ln = line.new(t0, mid, bar_index + 1, mid, extend = extend.right, color = color.new(base, 40), style = line.style_dotted)
    array.push(zones, Zone.new(top = top, bot = bot, dir = dir, kind = kind, score = score, t0 = t0, cb = bar_index, ext = ext, used = false, bx = bx, mid = ln))
    while array.size(zones) > maxZones
        f_removeZone(array.shift(zones))
    true

// Order block for a structure break in direction `dir`. anchorBar = bar of the swing that was broken.
f_createOB(int dir, int anchorBar) =>
    int span = math.min(bar_index - anchorBar, 400)
    float ext = dir == 1 ? low : high
    int o = 0
    for i = 0 to span
        if dir == 1 and low[i] < ext
            ext := low[i]
            o := i
        else if dir == -1 and high[i] > ext
            ext := high[i]
            o := i
    int c = na
    if obMode == OBM_LAST and o >= 1
        for i = 1 to o
            if f_isOpp(dir, i)
                c := i
                break
    if na(c)
        for i = o to o + 3
            if bar_index - i >= 0 and f_isOpp(dir, i)
                c := i
                break
    if na(c)
        c := o
    int cEnd = c
    while cEnd - c < 2 and bar_index - (cEnd + 1) >= 0 and f_isOpp(dir, cEnd + 1)
        cEnd += 1
    float zTop = high[c]
    float zBot = low[c]
    for j = c to cEnd
        zTop := math.max(zTop, high[j])
        zBot := math.min(zBot, low[j])
    float mid = (zTop + zBot) / 2

    float need = dispMult * atr
    bool dispOK = false
    for i = 0 to 2
        if (dir == 1 and close[i] - open[i] >= need) or (dir == -1 and open[i] - close[i] >= need)
            dispOK := true
    bool bigCandle = (zTop - zBot) >= 0.7 * atr

    bool liq = false
    int lb = math.min(15, bar_index - o - 1)
    if lb >= 1
        float pr = dir == 1 ? low[o + 1] : high[o + 1]
        for k = o + 1 to o + lb
            pr := dir == 1 ? math.min(pr, low[k]) : math.max(pr, high[k])
        liq := dir == 1 ? ext < pr : ext > pr

    bool fvgMade = false
    bool overlap = false
    if array.size(zones) > 0
        for k = 0 to array.size(zones) - 1
            Zone fz = array.get(zones, k)
            if fz.kind == 2 and fz.dir == dir and fz.cb >= bar_index - o - 1
                fvgMade := true
                if fz.top >= zBot and fz.bot <= zTop
                    overlap := true

    int score = (dispOK ? 1 : 0) + (fvgMade ? 1 : 0) + (liq ? 1 : 0) + (bigCandle ? 1 : 0) + f_loc(dir, mid) + (overlap ? 1 : 0)
    if showOB and score >= minShow
        f_addZone(zTop, zBot, dir, 0, score, bar_index - cEnd, ext, overlap)
    true

// External range liquidity, nearest first: equal highs / lows, then the sync-timeframe range,
// direction-timeframe range and chart range. Prefers the nearest target that pays at least minRR.
f_pickTarget(int dir, float entry, float risk) =>
    float pick = na
    float far = na
    array<float> cand = array.new_float()
    array.push(cand, dir == 1 ? syncHi : syncLo)
    array.push(cand, dir == 1 ? dirHi : dirLo)
    array.push(cand, dir == 1 ? rHi : rLo)
    if array.size(liqs) > 0
        for k = 0 to array.size(liqs) - 1
            Liq q = array.get(liqs, k)
            if q.eq and q.side == dir
                array.push(cand, q.px)
    for k = 0 to array.size(cand) - 1
        float t = array.get(cand, k)
        if not na(t) and (dir == 1 ? t > entry : t < entry)
            if na(far) or math.abs(t - entry) > math.abs(far - entry)
                far := t
            if math.abs(t - entry) / risk >= minRR and (na(pick) or math.abs(t - entry) < math.abs(pick - entry))
                pick := t
    na(pick) ? far : pick

// Entry, stop, target and reward:risk for a zone.
f_plan(Zone z) =>
    float mid = (z.top + z.bot) / 2
    float entry = entryMode == "Zone edge" ? (z.dir == 1 ? z.top : z.bot) : entryMode == "50% mean" ? mid : close
    float buf = slBuf * atr
    float ctxLong = math.min(nz(ctxBullBot, z.bot), z.bot, nz(z.ext, z.bot))
    float ctxShort = math.max(nz(ctxBearTop, z.top), z.top, nz(z.ext, z.top))
    bool cont = syncTrend == z.dir
    bool useCtx = stopMode == "Context POI" or (stopMode == "Auto" and not cont)
    bool useExt = not useCtx and (stopMode == "Zone extreme" or stopMode == "Auto")
    float slL = (useCtx ? ctxLong : useExt ? math.min(z.ext, z.bot) : z.bot) - buf
    float slS = (useCtx ? ctxShort : useExt ? math.max(z.ext, z.top) : z.top) + buf
    float sl = z.dir == 1 ? slL : slS
    bool okRisk = z.dir == 1 ? entry > sl : entry < sl
    float tp = okRisk ? f_pickTarget(z.dir, entry, math.abs(entry - sl)) : na
    float rr = na(tp) ? na : math.abs(tp - entry) / math.abs(entry - sl)
    [entry, sl, tp, rr]

f_drawTrade(int dir, float en, float sl, float tp, float rr, int score, string tag, float zTop, float zBot, float frac, float u0in) =>
    int r = bar_index + 15
    float riskAmt = acct * f_riskPct(dir) / 100
    float risk = math.abs(en - sl)
    float t1 = en + dir * minRR * risk
    string sizeTxt = ""
    float avgE = en
    if scaleMode == "Scale in zone"
        float eTop = dir == 1 ? zTop : zBot
        float eBot = dir == 1 ? zBot : zTop
        float eMid = (zTop + zBot) / 2
        float wsum = wTop + wMid + wBot
        float wavg = (wTop * math.abs(eTop - sl) + wMid * math.abs(eMid - sl) + wBot * math.abs(eBot - sl)) / wsum
        float u = wavg > 0 ? riskAmt / wavg : na
        float s1 = u * wTop / wsum
        float s2 = u * wMid / wsum
        float s3 = u * wBot / wsum
        avgE := (eTop * s1 + eMid * s2 + eBot * s3) / u
        sizeTxt := "scale in zone " + str.tostring(s1, "#.####") + " / " + str.tostring(s2, "#.####") + " / " + str.tostring(s3, "#.####") + "\nrisk if all fill " + str.tostring(riskAmt, "#") + ", RR at avg " + str.tostring(math.abs(tp - avgE) / math.abs(avgE - sl), "#.0")
        array.push(tLines, line.new(bar_index, eMid, r, eMid, color = colLiq, style = line.style_dotted))
        array.push(tLines, line.new(bar_index, eBot, r, eBot, color = colLiq, style = line.style_dotted))
        array.push(tLabels, label.new(r, eMid, "E2", style = label.style_label_left, color = color.new(colLiq, 80), textcolor = colLiq, size = size.tiny))
        array.push(tLabels, label.new(r, eBot, "E3", style = label.style_label_left, color = color.new(colLiq, 80), textcolor = colLiq, size = size.tiny))
    else
        float u0 = na(u0in) ? riskAmt / risk : u0in
        sizeTxt := "size " + str.tostring(u0 * frac, "#.####") + (frac < 1 ? " (" + str.tostring(frac * 100, "#") + "% of full)" : " (risk " + str.tostring(riskAmt, "#") + ")")
    array.push(tBoxes, box.new(bar_index, math.max(en, sl), r, math.min(en, sl), border_color = na, bgcolor = color.new(colBear, 82)))
    array.push(tBoxes, box.new(bar_index, math.max(en, tp), r, math.min(en, tp), border_color = na, bgcolor = color.new(colBull, 82)))
    array.push(tLines, line.new(bar_index, t1, r, t1, color = colBull, style = line.style_dashed))
    array.push(tLabels, label.new(r, t1, str.tostring(minRR, "#.#") + "R", style = label.style_label_left, color = color.new(colBull, 80), textcolor = colBull, size = size.tiny))
    if showPart and array.size(liqs) > 0
        float partLvl = na
        for k = 0 to array.size(liqs) - 1
            Liq q = array.get(liqs, k)
            if q.side == dir and (dir == 1 ? (q.px > en and q.px < t1) : (q.px < en and q.px > t1))
                if na(partLvl) or math.abs(q.px - en) < math.abs(partLvl - en)
                    partLvl := q.px
        if not na(partLvl)
            array.push(tLines, line.new(bar_index, partLvl, r, partLvl, color = colMSS, style = line.style_dotted))
            array.push(tLabels, label.new(r, partLvl, "partial " + str.tostring(partPct, "#") + "%", style = label.style_label_left, color = color.new(colMSS, 80), textcolor = colMSS, size = size.tiny))
    array.push(tLabels, label.new(bar_index, en, (dir == 1 ? "LONG " : "SHORT ") + tag + " RR " + str.tostring(rr, "#.0") + "  ★" + str.tostring(score) + "\n" + sizeTxt,
         style = dir == 1 ? label.style_label_up : label.style_label_down, color = dir == 1 ? colBull : colBear, textcolor = color.white, size = size.small))
    while array.size(tBoxes) > 12
        box.delete(array.shift(tBoxes))
    while array.size(tLines) > 20
        line.delete(array.shift(tLines))
    while array.size(tLabels) > 30
        label.delete(array.shift(tLabels))
    true

// ───────────────────────────── Liquidity ─────────────────────────────
var int lastSslSweep = na
var int lastBslSweep = na
bool sweepBull = false
bool sweepBear = false

if not na(ph) or not na(pl)
    for s = 0 to 1
        float px = s == 0 ? ph : pl
        int side = s == 0 ? 1 : -1
        if not na(px)
            bool isEq = false
            if array.size(liqs) > 0
                for k = 0 to array.size(liqs) - 1
                    Liq q = array.get(liqs, k)
                    if q.side == side and math.abs(q.px - px) <= eqTol * atr
                        isEq := true
                        q.eq := true
                        if not na(q.ln)
                            line.set_width(q.ln, 2)
            line ln = na
            if showLiq
                ln := line.new(bar_index - swingN, px, bar_index, px, extend = extend.right, color = color.new(colLiq, isEq ? 20 : 55), width = isEq ? 2 : 1, style = line.style_dotted)
            if isEq and showLiq
                label.new(bar_index - swingN, px, side == 1 ? "EQH" : "EQL", style = side == 1 ? label.style_label_down : label.style_label_up, color = color.new(colLiq, 80), textcolor = colLiq, size = size.tiny)
            array.push(liqs, Liq.new(px = px, side = side, bar = bar_index - swingN, ln = ln, eq = isEq, brk = na))
    while array.size(liqs) > maxLiq
        Liq oldest = array.shift(liqs)
        line.delete(oldest.ln)

int nLiq = array.size(liqs)
if nLiq > 0
    for k = 1 to nLiq
        int i = nLiq - k
        Liq l = array.get(liqs, i)
        bool done = false
        bool swept = false
        string how = ""
        if l.side == 1
            if na(l.brk)
                if high > l.px
                    if close < l.px
                        swept := true
                        how := "SFP"
                    else
                        l.brk := bar_index
            else if close < l.px and bar_index - l.brk <= 3
                swept := true
                how := "BAC"
            else if bar_index - l.brk > 3
                done := true
        else
            if na(l.brk)
                if low < l.px
                    if close > l.px
                        swept := true
                        how := "SFP"
                    else
                        l.brk := bar_index
            else if close > l.px and bar_index - l.brk <= 3
                swept := true
                how := "BAC"
            else if bar_index - l.brk > 3
                done := true
        if swept
            done := true
            if l.side == 1
                sweepBear := true
                lastBslSweep := bar_index
            else
                sweepBull := true
                lastSslSweep := bar_index
            if showSweeps
                label.new(bar_index, l.side == 1 ? high : low, (inNews ? "NEWS " : "") + (l.eq ? "EQ " : "") + how + (l.side == 1 ? " ↓" : " ↑"),
                     style = l.side == 1 ? label.style_label_down : label.style_label_up,
                     color = color.new(l.side == 1 ? colBear : colBull, 75), textcolor = l.side == 1 ? colBear : colBull, size = size.tiny)
        if done
            if not na(l.ln)
                line.set_extend(l.ln, extend.none)
                line.set_x2(l.ln, bar_index)
                line.set_style(l.ln, swept ? line.style_solid : line.style_dotted)
                line.set_color(l.ln, color.new(swept ? (l.side == 1 ? colBear : colBull) : colLiq, 70))
            array.remove(liqs, i)

bool recentSsl = not na(lastSslSweep) and bar_index - lastSslSweep <= sweepLook
bool recentBsl = not na(lastBslSweep) and bar_index - lastBslSweep <= sweepLook

// SMT divergence: one asset makes a new swing extreme, the correlated one clearly does not, at a key level
// (inside a context POI, or right after a liquidity sweep). Same timeframe on both charts.
[cHigh, cLow] = request.security(smtSym, timeframe.period, [high, low], lookahead = barmerge.lookahead_off)
float lowN   = ta.lowest(low, smtLen)[1]
float highN  = ta.highest(high, smtLen)[1]
float cLowN  = ta.lowest(cLow, smtLen)[1]
float cHighN = ta.highest(cHigh, smtLen)[1]
bool newLowA  = low < lowN
bool newLowB  = cLow < cLowN
bool newHighA = high > highN
bool newHighB = cHigh > cHighN
bool keyBull = (not na(ctxBullTop) and low <= ctxBullTop and high >= ctxBullBot) or recentSsl
bool keyBear = (not na(ctxBearTop) and high >= ctxBearBot and low <= ctxBearTop) or recentBsl
bool smtBull = useSMT and keyBull and ((newLowA and not newLowB and cLow > cLowN * (1 + smtGap / 100)) or (newLowB and not newLowA and low > lowN * (1 + smtGap / 100)))
bool smtBear = useSMT and keyBear and ((newHighA and not newHighB and cHigh < cHighN * (1 - smtGap / 100)) or (newHighB and not newHighA and high < highN * (1 - smtGap / 100)))
if smtBull
    lastSmtBull := bar_index
    label.new(bar_index, low, "SMT ↑", style = label.style_label_up, color = color.new(colBull, 75), textcolor = colBull, size = size.tiny)
if smtBear
    lastSmtBear := bar_index
    label.new(bar_index, high, "SMT ↓", style = label.style_label_down, color = color.new(colBear, 75), textcolor = colBear, size = size.tiny)

// ───────────── Episode 22: liquidity map and daily bias checklist ─────────────
[prevDH, prevDL, prevDC] = request.security(syminfo.tickerid, "D", [high[1], low[1], close[1]], lookahead = barmerge.lookahead_on)
[prevWH, prevWL] = request.security(syminfo.tickerid, "W", [high[1], low[1]], lookahead = barmerge.lookahead_on)
[prevMH, prevML] = request.security(syminfo.tickerid, "M", [high[1], low[1]], lookahead = barmerge.lookahead_on)
bool newDay   = ta.change(time("D")) != 0
bool newWeek  = ta.change(time("W")) != 0
bool newMonth = ta.change(time("M")) != 0
var float curDH = na
var float curDL = na
var float curWH = na
var float curWL = na
var float curMH = na
var float curML = na
curDH := newDay ? high : math.max(nz(curDH, high), high)
curDL := newDay ? low : math.min(nz(curDL, low), low)
curWH := newWeek ? high : math.max(nz(curWH, high), high)
curWL := newWeek ? low : math.min(nz(curWL, low), low)
curMH := newMonth ? high : math.max(nz(curMH, high), high)
curML := newMonth ? low : math.min(nz(curML, low), low)
bool dHiSw = curDH > prevDH
bool dLoSw = curDL < prevDL
bool wHiSw = curWH > prevWH
bool wLoSw = curWL < prevWL
bool mHiSw = curMH > prevMH
bool mLoSw = curML < prevML

// Step 1 of the checklist: where is the higher-timeframe draw on liquidity? A swept high points down,
// a swept low points up; if neither is swept, the nearer one.
f_draw(bool hiSw, bool loSw, float hi, float lo) =>
    int d = 0
    if hiSw and not loSw
        d := -1
    else if loSw and not hiSw
        d := 1
    else if not hiSw and not loSw and not na(hi) and not na(lo)
        d := (hi - close) < (close - lo) ? 1 : -1
    d

int wkDraw = f_draw(wHiSw, wLoSw, prevWH, prevWL)
int drawDir = wkDraw != 0 ? wkDraw : f_draw(mHiSw, mLoSw, prevMH, prevML)
// Step 2: where did yesterday's daily candle close inside its own range?
float rngD = prevDH - prevDL
float closePos = rngD > 0 ? (prevDC - prevDL) / rngD : na
bool noBiasDay = not na(closePos) and closePos > closeEdge and closePos < 1 - closeEdge
bool wkDiscount = not na(dirHi) and not na(dirLo) and dirHi > dirLo and close < (dirHi + dirLo) / 2
bool wkPremium  = not na(dirHi) and not na(dirLo) and dirHi > dirLo and close > (dirHi + dirLo) / 2
// Step 3: has the manipulation already happened, and was it early or late in the day?
bool earlyDay = isIntra ? (time - time("D")) / 3600000 < earlyHours : true
bool bullSweepOK = not dLoSw or earlyDay
bool bearSweepOK = not dHiSw or earlyDay
int dailyBias = 0
if not na(closePos) and not noBiasDay
    if drawDir == 1 and closePos <= closeEdge and dirTrend == 1 and wkDiscount and bullSweepOK
        dailyBias := 1
    if drawDir == -1 and closePos >= 1 - closeEdge and dirTrend == -1 and wkPremium and bearSweepOK
        dailyBias := -1

float prevWMid = (prevWH + prevWL) / 2
plot(showMap ? prevDH : na, "Previous day high", color = dHiSw ? color.new(colLiq, 85) : color.new(colBear, 40), style = plot.style_linebr)
plot(showMap ? prevDL : na, "Previous day low", color = dLoSw ? color.new(colLiq, 85) : color.new(colBull, 40), style = plot.style_linebr)
plot(showMap ? prevWH : na, "Previous week high", color = wHiSw ? color.new(colLiq, 80) : color.new(colBear, 20), linewidth = 2, style = plot.style_linebr)
plot(showMap ? prevWL : na, "Previous week low", color = wLoSw ? color.new(colLiq, 80) : color.new(colBull, 20), linewidth = 2, style = plot.style_linebr)
plot(showMap ? prevMH : na, "Previous month high", color = mHiSw ? color.new(colLiq, 75) : color.new(colBear, 0), linewidth = 3, style = plot.style_linebr)
plot(showMap ? prevML : na, "Previous month low", color = mLoSw ? color.new(colLiq, 75) : color.new(colBull, 0), linewidth = 3, style = plot.style_linebr)
plot(showMap ? prevWMid : na, "Previous week 50%", color = color.new(colMSS, 60), style = plot.style_linebr)

// ───────────────────────── Fair value gaps ─────────────────────────
// Episode 23: a Wyckoff spring / UTAD is just an AMD cycle inside a compressed range: one side is swept and
// reclaimed, then structure breaks the other way. Chart patterns are descriptions of liquidity plus structure.
float amdHi = ta.highest(high, amdN)[1]
float amdLo = ta.lowest(low, amdN)[1]
bool tightRange = (amdHi - amdLo) <= amdMult * atr
var int springBar = na
var int utadBar = na
if showAMD and tightRange and low < amdLo and close > amdLo
    springBar := bar_index
if showAMD and tightRange and high > amdHi and close < amdHi
    utadBar := bar_index
bool amdBull = false
bool amdBear = false
if showAMD and bullBrk and not na(springBar) and bar_index - springBar <= amdWindow
    amdBull := true
    springBar := na
    label.new(bar_index, low, "AMD ↑ spring", style = label.style_label_up, color = color.new(colBull, 75), textcolor = colBull, size = size.tiny)
if showAMD and bearBrk and not na(utadBar) and bar_index - utadBar <= amdWindow
    amdBear := true
    utadBar := na
    label.new(bar_index, high, "AMD ↓ UTAD", style = label.style_label_down, color = color.new(colBear, 75), textcolor = colBear, size = size.tiny)

// Step 1 of the 5-minute model: price must trade INTO the context-timeframe POI, not just near it.
var int lastTagL = na
var int lastTagS = na
var int mBullBrk = na
var int mBearBrk = na
var float modelExtBull = na
var float modelExtBear = na
if not na(ctxBullTop) and low <= ctxBullTop and high >= ctxBullBot
    lastTagL := bar_index
if not na(ctxBearTop) and high >= ctxBearBot and low <= ctxBearTop
    lastTagS := bar_index

bool fvgBull = low > high[2] and close[1] > open[1] and (close[1] - open[1]) >= dispMult * atr[1] and (low - high[2]) >= fvgMin * atr
bool fvgBear = high < low[2] and close[1] < open[1] and (open[1] - close[1]) >= dispMult * atr[1] and (low[2] - high) >= fvgMin * atr
if (showFVG or modelOn) and fvgBull
    float m = (low + high[2]) / 2
    int sc = 1 + f_loc(1, m) + (recentSsl ? 1 : 0)
    if sc >= minShow or modelOn
        f_addZone(low, high[2], 1, 2, sc, bar_index - 2, low[2], false)
        if modelOn and not na(mBullBrk) and bar_index - mBullBrk <= 3
            Zone lz = array.get(zones, array.size(zones) - 1)
            lz.fromModel := true
            lz.ext := modelExtBull
if (showFVG or modelOn) and fvgBear
    float m = (high + low[2]) / 2
    int sc = 1 + f_loc(-1, m) + (recentBsl ? 1 : 0)
    if sc >= minShow or modelOn
        f_addZone(low[2], high, -1, 2, sc, bar_index - 2, high[2], false)
        if modelOn and not na(mBearBrk) and bar_index - mBearBrk <= 3
            Zone lz = array.get(zones, array.size(zones) - 1)
            lz.fromModel := true
            lz.ext := modelExtBear

// ───────────────────────── Order blocks from structure breaks ─────────────────────────
if bullBrk
    f_createOB(1, bullAnchor)
if bearBrk
    f_createOB(-1, bearAnchor)

// Steps 2-3 of the 5-minute model: structure break in the trade direction, after the zone tag,
// with displacement. The FVG it leaves (created since the broken swing, or within 3 bars after) is the entry.
if modelOn and bullBrk and not na(lastTagL) and bar_index - lastTagL <= tagLook and (not reqDisp or f_disp(1))
    mBullBrk := bar_index
    float legExt = low
    for i = 0 to math.min(bar_index - bullAnchor, 400)
        legExt := math.min(legExt, low[i])
    modelExtBull := legExt
    if array.size(zones) > 0
        for k = 0 to array.size(zones) - 1
            Zone fz = array.get(zones, k)
            if fz.kind == 2 and fz.dir == 1 and fz.cb >= bullAnchor
                fz.fromModel := true
                fz.ext := legExt
if modelOn and bearBrk and not na(lastTagS) and bar_index - lastTagS <= tagLook and (not reqDisp or f_disp(-1))
    mBearBrk := bar_index
    float legExt = high
    for i = 0 to math.min(bar_index - bearAnchor, 400)
        legExt := math.max(legExt, high[i])
    modelExtBear := legExt
    if array.size(zones) > 0
        for k = 0 to array.size(zones) - 1
            Zone fz = array.get(zones, k)
            if fz.kind == 2 and fz.dir == -1 and fz.cb >= bearAnchor
                fz.fromModel := true
                fz.ext := legExt

// ───────────────────────── Zone maintenance and setup signals ─────────────────────────
var array<int>   trDir = array.new<int>()
var array<float> trSl   = array.new<float>()
var array<float> trTp   = array.new<float>()
var int wins = 0
var int losses = 0
var int consecLoss = 0
var int lastLossBar = na
var int lastChase = na
var int sigToday = 0
if tiltN > 0 and consecLoss >= tiltN and not na(lastLossBar) and bar_index - lastLossBar > tiltCool
    consecLoss := 0
bool tiltBlocked = tiltN > 0 and consecLoss >= tiltN
if newDay
    sigToday := 0
bool capHit = maxDaily > 0 and sigToday >= maxDaily

// Timing / discipline gates: kill zone, silver bullet, news window, tilt guard.
bool kzOK     = (not reqKZ or inKZ) and (not reqSB or inSB) and (not reqCrypto or inCrypto) and not inNews and not tiltBlocked and not capHit
[stkLn, stkLt] = f_stack(1)
[stkSn, stkSt] = f_stack(-1)
bool smtOKL    = not reqSMT or (not na(lastSmtBull) and bar_index - lastSmtBull <= smtLook)
bool smtOKS    = not reqSMT or (not na(lastSmtBear) and bar_index - lastSmtBear <= smtLook)
bool biasOKL   = (not reqBias or dailyBias == 1) and not (skipNoBias and noBiasDay)
bool biasOKS   = (not reqBias or dailyBias == -1) and not (skipNoBias and noBiasDay)
bool stkL      = stkLn >= minStack and smtOKL and biasOKL
bool stkS      = stkSn >= minStack and smtOKS and biasOKS
bool confL     = not reqConfirm or syncTrend == 1 or ctxTrend == 1 or setupTrend == 1
bool confS     = not reqConfirm or syncTrend == -1 or ctxTrend == -1 or setupTrend == -1
bool sweepOKL = not reqSweep or recentSsl
bool sweepOKS = not reqSweep or recentBsl

Zone bestL = na
Zone bestS = na
int nZ = array.size(zones)
if nZ > 0
    for k = 1 to nZ
        int i = nZ - k
        Zone z = array.get(zones, i)
        bool kill = bar_index - z.cb > lifeBars
        if z.kind == 0
            if z.dir == 1 and close < z.bot
                kill := true
            if z.dir == -1 and close > z.top
                kill := true
            if kill and showBrk and bar_index - z.cb <= lifeBars
                float e = z.dir == 1 ? high : low
                int lbk = math.min(bar_index - z.t0, 200)
                for j = 0 to lbk
                    e := z.dir == 1 ? math.max(e, high[j]) : math.min(e, low[j])
                array.push(pend, Zone.new(top = z.top, bot = z.bot, dir = -z.dir, kind = 1, score = z.score, t0 = z.t0, cb = bar_index, ext = e, used = false))
        else
            if z.dir == 1 and close < z.bot
                kill := true
            if z.dir == -1 and close > z.top
                kill := true
            if z.kind == 2 and modelOn and not showFVG and not z.fromModel and bar_index - z.cb > 60
                kill := true
            if z.kind == 2 and z.fromModel and not z.used and bar_index > z.cb and ((z.dir == 1 and high > z.top + missRun * atr) or (z.dir == -1 and low < z.bot - missRun * atr))
                kill := true
                lastChase := bar_index
        bool modelZone = modelOn and z.kind == 2 and z.fromModel
        bool generalZone = not modelOn and z.score >= minScoreEnt and (z.kind < 2 or fvgEntries)
        if kill
            f_removeZone(z)
            array.remove(zones, i)
        else if enableSig and barstate.isconfirmed and not z.used and bar_index > z.cb and (modelZone or generalZone)
            float mid = (z.top + z.bot) / 2
            float trig = entryMode == "50% mean" ? mid : (z.dir == 1 ? z.top : z.bot)
            if z.dir == 1 and (allowCtr or biasDir == 1) and (not reqSync or trend == 1)
                bool touched = low <= trig and close >= mid
                bool locOK = not reqPD or (not na(pdMid) and mid < pdMid)
                bool poiOK = modelZone or not reqPOI or (not na(ctxBullTop) and z.bot <= ctxBullTop and z.top >= ctxBullBot)
                if touched and locOK and poiOK and confL and stkL and kzOK and sweepOKL and (na(bestL) or z.score > bestL.score)
                    bestL := z
            if z.dir == -1 and (allowCtr or biasDir == -1) and (not reqSync or trend == -1)
                bool touched = high >= trig and close <= mid
                bool locOK = not reqPD or (not na(pdMid) and mid > pdMid)
                bool poiOK = modelZone or not reqPOI or (not na(ctxBearTop) and z.top >= ctxBearBot and z.bot <= ctxBearTop)
                if touched and locOK and poiOK and confS and stkS and kzOK and sweepOKS and (na(bestS) or z.score > bestS.score)
                    bestS := z

if array.size(pend) > 0
    for k = 0 to array.size(pend) - 1
        Zone p = array.get(pend, k)
        f_addZone(p.top, p.bot, p.dir, 1, p.score, p.t0, p.ext, false)
    array.clear(pend)

// Add-on campaign state (episode 17): adds only while the campaign stop has not been hit.
var int   campDir  = 0
var int   campN    = 0
var float campStop = na
var float campU0   = na
if campDir == 1 and low <= campStop
    campDir := 0
    campN := 0
if campDir == -1 and high >= campStop
    campDir := 0
    campN := 0

bool longSig = false
bool shortSig = false
float sigEntry = na
float sigStop = na
float sigTarget = na
float sigRR = na
if not na(bestL)
    [en, sl, tp, rr] = f_plan(bestL)
    bool isAdd = scaleMode == "Add on confirmation" and campDir == 1 and campN >= 1 and campN <= maxAdds
    float slUse = (isAdd and trailStops) ? math.max(campStop, bestL.ext - slBuf * atr) : sl
    float rrUse = (not na(tp) and en > slUse) ? math.abs(tp - en) / math.abs(en - slUse) : na
    if not na(rrUse) and rrUse >= minRR
        longSig := true
        bestL.used := true
        float fr = 1.0
        float u0 = na
        string tg = (syncTrend == 1 ? "CONT" : "REV") + (inSB ? " SB" : "") + " " + f_grade(1)
        if scaleMode == "Add on confirmation"
            if isAdd
                campN += 1
                fr := (1 - firstPct / 100) / maxAdds
                u0 := campU0
                campStop := slUse
                tg := tg + " ADD" + str.tostring(campN - 1)
            else
                campDir := 1
                campN := 1
                campStop := slUse
                campU0 := acct * f_riskPct(1) / 100 / math.abs(en - slUse)
                fr := firstPct / 100
                u0 := campU0
        sigEntry := en
        sigStop := slUse
        sigTarget := tp
        sigRR := rrUse
        f_drawTrade(1, en, slUse, tp, rrUse, bestL.score, tg, bestL.top, bestL.bot, fr, u0)
if not na(bestS) and not longSig
    [en, sl, tp, rr] = f_plan(bestS)
    bool isAdd = scaleMode == "Add on confirmation" and campDir == -1 and campN >= 1 and campN <= maxAdds
    float slUse = (isAdd and trailStops) ? math.min(campStop, bestS.ext + slBuf * atr) : sl
    float rrUse = (not na(tp) and en < slUse) ? math.abs(tp - en) / math.abs(en - slUse) : na
    if not na(rrUse) and rrUse >= minRR
        shortSig := true
        bestS.used := true
        float fr = 1.0
        float u0 = na
        string tg = (syncTrend == -1 ? "CONT" : "REV") + (inSB ? " SB" : "") + " " + f_grade(-1)
        if scaleMode == "Add on confirmation"
            if isAdd
                campN += 1
                fr := (1 - firstPct / 100) / maxAdds
                u0 := campU0
                campStop := slUse
                tg := tg + " ADD" + str.tostring(campN - 1)
            else
                campDir := -1
                campN := 1
                campStop := slUse
                campU0 := acct * f_riskPct(-1) / 100 / math.abs(en - slUse)
                fr := firstPct / 100
                u0 := campU0
        sigEntry := en
        sigStop := slUse
        sigTarget := tp
        sigRR := rrUse
        f_drawTrade(-1, en, slUse, tp, rrUse, bestS.score, tg, bestS.top, bestS.bot, fr, u0)

if longSig or shortSig
    sigToday += 1

int nTr = array.size(trDir)
if nTr > 0
    for k = 1 to nTr
        int i = nTr - k
        int d = array.get(trDir, i)
        float slv = array.get(trSl, i)
        float tpv = array.get(trTp, i)
        bool hitSl = d == 1 ? low <= slv : high >= slv
        bool hitTp = d == 1 ? high >= tpv : low <= tpv
        if hitSl or hitTp
            if hitSl
                losses += 1
                consecLoss += 1
                lastLossBar := bar_index
            else
                wins += 1
                consecLoss := 0
            array.remove(trDir, i)
            array.remove(trSl, i)
            array.remove(trTp, i)
if longSig or shortSig
    array.push(trDir, longSig ? 1 : -1)
    array.push(trSl, sigStop)
    array.push(trTp, winAt == "2R" ? sigEntry + (longSig ? 1 : -1) * minRR * math.abs(sigEntry - sigStop) : sigTarget)

plotshape(longSig, "Long setup", shape.triangleup, location.belowbar, colBull, size = size.small, text = "L")
plotshape(shortSig, "Short setup", shape.triangledown, location.abovebar, colBear, size = size.small, text = "S")

// ───────────────────────────── Dashboard ─────────────────────────────
var table dash = table.new(dashPos, 2, 17, border_width = 1, frame_color = color.new(colLiq, 60), border_color = color.new(colLiq, 80), bgcolor = color.new(color.black, 20))

f_tick(bool ok) => ok ? "✓" : "✗"

if showDash and barstate.islast
    int dirC = biasDir
    string dirTxt = dirC == 1 ? "Bullish" : dirC == -1 ? "Bearish" : "Wait"
    color dirCol = dirC == 1 ? colBull : dirC == -1 ? colBear : colLiq
    string syncTxt = not useHTF ? "off" : dirTrend == 0 ? "No bias" : dirTrend == syncTrend ? "Synced (continuation)" : allowRev ? "Against (reversal)" : "Against - wait"
    bool syncTFOK = not useHTF or (dirTrend != 0 and (dirTrend == syncTrend or allowRev))
    bool confOK = not useHTF or not reqConfirm or (dirC != 0 and (syncTrend == dirC or ctxTrend == dirC or setupTrend == dirC))
    bool locOKd = not na(pdMid) and ((dirC == 1 and close < pdMid) or (dirC == -1 and close > pdMid))
    string locTxt = na(pdMid) ? "n/a" : close < pdMid ? "Discount" : close > pdMid ? "Premium" : "Equilibrium"
    bool poiExists = dirC == 1 ? not na(ctxBullTop) : dirC == -1 ? not na(ctxBearTop) : false
    bool poiTagged = dirC == 1 ? (poiExists and lo20 <= ctxBullTop) : dirC == -1 ? (poiExists and hi20 >= ctxBearBot) : false
    Zone bz = na
    if dirC != 0 and array.size(zones) > 0
        for k = 0 to array.size(zones) - 1
            Zone zz = array.get(zones, k)
            bool okZ = modelOn ? (zz.kind == 2 and zz.fromModel) : (zz.score >= minScoreEnt and (zz.kind < 2 or fvgEntries))
            if zz.dir == dirC and okZ and (na(bz) or zz.score > bz.score)
                bz := zz
    bool modelOK = not na(bz) and trend == dirC
    float planRR = na
    float planSize = na
    if not na(bz)
        [pe, ps, pt, pr] = f_plan(bz)
        planRR := pr
        planSize := math.abs(pe - ps) > 0 ? (acct * f_riskPct(dirC) / 100) / math.abs(pe - ps) : na
    bool rrOK = not na(planRR) and planRR >= minRR
    string sess = (inSB ? "Silver bullet / " : "") + (inLon ? "London KZ" : inNY ? "New York KZ" : inPM ? "NY afternoon" : inAsia ? "Asia" : "-")

    table.cell(dash, 0, 0, "Top-down checklist", text_color = color.white, text_size = size.small, bgcolor = color.new(colLiq, 60))
    table.cell(dash, 1, 0, syminfo.ticker + " | " + scaleMode, text_color = color.white, text_size = size.small, bgcolor = color.new(colLiq, 60))
    table.cell(dash, 0, 1, "1a Direction (" + dirTF + ")", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, (not dirClear ? "Ranging" : dirTrend == 1 ? "Bullish" : dirTrend == -1 ? "Bearish" : "Range") + " " + f_tick(dirTrend != 0 and dirClear), text_color = not dirClear ? colLiq : dirTrend == 1 ? colBull : dirTrend == -1 ? colBear : colLiq, text_size = size.small)
    table.cell(dash, 0, 2, "1b Sync (" + syncTF + ")", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, syncTxt + " " + f_tick(syncTFOK), text_color = syncTFOK ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 3, "2 Location in range", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, locTxt + " " + f_tick(locOKd), text_color = locOKd ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 4, "2 Context POI (" + ctxTF + ")", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4, (poiExists ? "Marked" : "None") + " " + f_tick(poiExists), text_color = poiExists ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 5, "3 Price tagged POI", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5, (poiTagged ? "Yes" : "Waiting") + " " + f_tick(poiTagged), text_color = poiTagged ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 6, "3 H4 / H1 confirmation", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 6, (dirC != 0 and syncTrend == dirC ? "Daily agrees" : dirC != 0 and ctxTrend == dirC ? "H4 flipped" : dirC != 0 and setupTrend == dirC ? "H1 flipped" : "Waiting") + " " + f_tick(confOK), text_color = confOK ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 7, modelOn ? "4 MSB + disp + FVG" : "4 Chart MSB + zone", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 7, (na(bz) ? "No zone" : (bz.kind == 0 ? "OB " : bz.kind == 1 ? "Breaker " : "FVG ") + str.tostring(bz.score)) + " " + f_tick(modelOK), text_color = modelOK ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 8, "Reward : risk", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 8, (na(planRR) ? "n/a" : str.tostring(planRR, "#.0") + "R, break-even " + str.tostring(100 / (1 + planRR), "#") + "%") + " " + f_tick(rrOK), text_color = rrOK ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 9, "Session", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 9, sess, text_color = inKZ ? colNY : colLiq, text_size = size.small)
    bool chased = not na(lastChase) and bar_index - lastChase <= 30
    string dq = dirC == 0 ? "1 No clear bias" : not locOKd ? "2 Wrong zone" : not rrOK ? "3 No target / under " + str.tostring(minRR, "#.#") + "R" : not modelOK ? "4 Model incomplete" : chased ? "5 Missed entry (no chase)" : inNews ? "6 News window" : tiltBlocked ? "7 Tilt guard" : capHit ? "8 Daily signal cap" : "None"
    bool allOK = dirC != 0 and syncTFOK and confOK and locOKd and poiExists and poiTagged and modelOK and rrOK and not inNews and not tiltBlocked and not capHit
    table.cell(dash, 0, 10, "No-trade filter", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 10, dq, text_color = dq == "None" ? colBull : colBear, text_size = size.small)
    table.cell(dash, 0, 11, "Signals W / L", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 11, str.tostring(wins) + " / " + str.tostring(losses) + (consecLoss > 0 ? "  (" + str.tostring(consecLoss) + " in a row)" : ""), text_color = color.white, text_size = size.small)
    table.cell(dash, 0, 12, "Size at " + str.tostring(f_riskPct(dirC), "#.##") + "% risk", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 12, na(planSize) ? "n/a" : str.tostring(planSize, "#.####") + " (risk " + str.tostring(acct * f_riskPct(dirC) / 100, "#") + ")" + (f_riskPct(dirC) > 2 ? " - above 2%, oversizing risk" : ""), text_color = f_riskPct(dirC) > 2 ? colBear : color.white, text_size = size.small)
    string grade = dirC != 0 ? f_grade(dirC) : "-"
    table.cell(dash, 0, 13, "Range stack W/D/4H/1H", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 13, f_letter(dirHi, dirLo) + " " + f_letter(syncHi, syncLo) + " " + f_letter(ctxHi, ctxLo) + " " + f_letter(setupHi, setupLo) + "  grade " + grade, text_color = grade == "A+" or grade == "A" ? colBull : colLiq, text_size = size.small)
    bool smtSeen = dirC == 1 ? (not na(lastSmtBull) and bar_index - lastSmtBull <= smtLook) : dirC == -1 ? (not na(lastSmtBear) and bar_index - lastSmtBear <= smtLook) : false
    table.cell(dash, 0, 14, "SMT vs " + (useSMT ? str.tostring(smtSym) : "off"), text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 14, not useSMT ? "off" : smtSeen ? "Divergence (grade up)" : "None (optional)", text_color = smtSeen ? colBull : colLiq, text_size = size.small)
    string biasTxt = noBiasDay ? "No-bias day (mid close)" : dailyBias == 1 ? "Bullish" : dailyBias == -1 ? "Bearish" : "Unclear"
    table.cell(dash, 0, 15, "Daily bias (ep 22)", text_color = color.white, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 15, biasTxt + " | draw " + (drawDir == 1 ? "up" : drawDir == -1 ? "down" : "-") + ", close " + (na(closePos) ? "n/a" : str.tostring(closePos * 100, "#") + "%"), text_color = dailyBias == 1 ? colBull : dailyBias == -1 ? colBear : colLiq, text_size = size.small)
    table.cell(dash, 0, 16, "Take the trade?", text_color = color.white, text_size = size.small, text_halign = text.align_left, bgcolor = color.new(allOK ? colBull : colBear, 70))
    table.cell(dash, 1, 16, allOK ? "All boxes ticked" : "Wait", text_color = allOK ? colBull : colBear, text_size = size.small, bgcolor = color.new(allOK ? colBull : colBear, 70))

// ───────────────────────────── Alerts ─────────────────────────────
alertcondition(longSig, "TM long setup", "Trader Mayne framework: long setup on {{ticker}} ({{interval}})")
alertcondition(shortSig, "TM short setup", "Trader Mayne framework: short setup on {{ticker}} ({{interval}})")
alertcondition(bullBrk and bullMSS, "TM bullish MSS", "Bullish market structure shift on {{ticker}} ({{interval}})")
alertcondition(bearBrk and bearMSS, "TM bearish MSS", "Bearish market structure shift on {{ticker}} ({{interval}})")
alertcondition(sweepBull, "TM sell-side sweep", "Sell-side liquidity swept on {{ticker}} ({{interval}})")
alertcondition(sweepBear, "TM buy-side sweep", "Buy-side liquidity swept on {{ticker}} ({{interval}})")
alertcondition(amdBull or amdBear, "TM range AMD", "Range sweep and structure break (spring / UTAD style AMD) on {{ticker}} ({{interval}})")
alertcondition(smtBull, "TM bullish SMT", "Bullish SMT divergence at a key level on {{ticker}} ({{interval}})")
alertcondition(smtBear, "TM bearish SMT", "Bearish SMT divergence at a key level on {{ticker}} ({{interval}})")
alertcondition(inNews and not inNews[1], "TM news window starting", "News window starting on {{ticker}}: no new entries, manage open trades")
alertcondition(inLon and not inLon[1], "TM London kill zone starting", "London kill zone starting on {{ticker}}")
alertcondition(inNY and not inNY[1], "TM New York kill zone starting", "New York kill zone starting on {{ticker}}")
alertcondition(judasBull or judasBear, "TM Judas swing", "Asian range Judas swing on {{ticker}} ({{interval}})")
